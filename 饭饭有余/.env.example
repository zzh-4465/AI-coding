# 仅供后端 server/ai-proxy.mjs 读取，不要改成 VITE_ARK_API_KEY。
ARK_API_KEY=ark-your-key-here
ARK_MODEL=doubao-seed-2-1-lite-260915
AI_PROXY_PORT=8787
# 本机默认只监听 127.0.0.1；云平台会通过 PORT 自动切换为 0.0.0.0。
# 只有局域网测试或云平台未提供 PORT 时才手动改为 0.0.0.0。
AI_PROXY_HOST=127.0.0.1
AI_RATE_LIMIT=60
AI_ALLOWED_ORIGINS=http://localhost:5173,https://localhost,http://localhost,capacitor://localhost
AI_ACCESS_TOKEN=

# Android/网页部署时填可访问的 HTTPS 后端地址，不要以 / 结尾；本地Vite开发可留空。
VITE_AI_API_BASE=
# 仅用于小范围内测，打包进 APK 后不能视为真正的秘密；正式版应换成登录令牌。
VITE_AI_ACCESS_TOKEN=
# 仅自己的内测包设 true；普通正式构建保持 false。
VITE_ENABLE_TEST_MEMBERSHIP=false

# 账号与云备份：仅服务端读取，未配置时保留游客离线记账。
DATABASE_URL=
# 可选：账号后端独立部署时填写 HTTPS 地址；留空沿用 VITE_AI_API_BASE。
VITE_ACCOUNT_API_BASE=

# 邮箱验证和找回：Railway 试用/Free/Hobby 禁用 SMTP，使用 HTTPS API。
MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=饭饭有余
# 仅允许 SMTP 的部署环境使用以下配置，并设置 MAIL_PROVIDER=smtp。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 普通版默认配置，不启用生日测试、定制版或免登录演示。
VITE_ENABLE_BIRTHDAY_TEST=false
VITE_CUSTOM_EDITION=
VITE_WEB_DEMO=false
